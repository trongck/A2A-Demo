# ==============================================================================
# CẤU HÌNH LINH HOẠT TẤT CẢ CÁC MODEL VÀ PROVIDER (OPENAI, GEMINI, DEEPSEEK, OPENROUTER, OLLAMA...)
# ==============================================================================

# Cách 1: Cấu hình chuẩn tổng quát (Chạy được với MỌI nhà cung cấp API):
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=

# Ví dụ khi dùng OpenRouter:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=anthropic/claude-3.5-sonnet

# Ví dụ khi dùng DeepSeek:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# Ví dụ khi dùng OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini

# Cách 2: Cấu hình theo biến môi trường chuẩn quen thuộc:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
