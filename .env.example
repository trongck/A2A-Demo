# ==============================================================================
# CẤU HÌNH LINH HOẠT TẤT CẢ CÁC MODEL VÀ PROVIDER (OPENAI, GEMINI, DEEPSEEK, OPENROUTER, OLLAMA...)
# ==============================================================================

# Cách 1: Cấu hình chuẩn tổng quát (Chạy được với MỌI nhà cung cấp API):
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=

# Ví dụ khi dùng OpenRouter:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=anthropic/claude-3.5-sonnet

# Ví dụ khi dùng DeepSeek:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# Ví dụ khi dùng OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini

# Cách 2: Cấu hình theo biến môi trường chuẩn quen thuộc:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ==============================================================================
# CẤU HÌNH BẢO MẬT V-AI (Để trống = tắt enforcement, phục vụ dev local)
# ==============================================================================

# API Key cho frontend gọi backend A0 (để trống = cho phép mọi request)
V_AI_API_KEY=

# Shared secret giữa A0 ↔ A1 ↔ A2 ↔ MCP (để trống = không xác thực inter-agent)
V_AI_INTERNAL_SECRET=

# CORS whitelist (phân cách bằng dấu phẩy)
V_AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limit (số request tối đa mỗi phút)
V_AI_RATE_LIMIT_PER_MINUTE=10
V_AI_RATE_LIMIT_READ_PER_MINUTE=60

# Độ dài tối đa tin nhắn (ký tự)
V_AI_MAX_MESSAGE_LENGTH=2000

